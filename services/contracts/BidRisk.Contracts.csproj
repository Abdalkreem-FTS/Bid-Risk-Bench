<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generated/ comes from `make proto` and is not committed. Run that before building. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BidRisk.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <NoWarn>$(NoWarn);CA1716;CA1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Core.Api" Version="2.83.0" />
  </ItemGroup>

</Project>
