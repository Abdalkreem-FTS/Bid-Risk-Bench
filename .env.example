POSTGRES_IMAGE_TAG=16.4-alpine
OLLAMA_IMAGE_TAG=0.5.7
PYTHON_IMAGE_TAG=3.12-slim-bookworm
DOTNET_SDK_TAG=10.0
DOTNET_RUNTIME_TAG=10.0
BUF_IMAGE_TAG=1.72.0

GATEWAY_HTTP_PORT=8080

AUCTION_GRPC_HOST=auction-service
AUCTION_GRPC_PORT=5001

ML_GRPC_HOST=ml-service
ML_GRPC_PORT=5002

OLLAMA_HOST=ollama
OLLAMA_PORT=11434

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bidrisk
POSTGRES_USER=bidrisk
POSTGRES_PASSWORD=bidrisk_local_dev
POSTGRES_MAX_POOL=20

MODEL_PATH=/app/models/bidrisk.joblib
RISK_LEVEL_LOW_MAX=0.40
RISK_LEVEL_MEDIUM_MAX=0.70
RISK_REJECT_THRESHOLD=0.70
SCORING_DEADLINE_MS=300
AUCTION_DEADLINE_MS=2000

OLLAMA_MODEL=llama3.2:1b-instruct-q4_K_M
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=200

LLM_NUM_THREAD=2
LLM_REQUEST_TIMEOUT_MS=120000
LLM_HISTORY_LIMIT=30
LLM_BIDS_IN_PROMPT=5
LLM_LOT_WINDOW=40

GATEWAY_BATCHING=off
GRPC_REFLECTION=true
LOG_LEVEL=INFO

TRAIN_SAMPLES=5000
TRAIN_SEED=42
TRAIN_SUSPICIOUS_RATE=0.15
TRAIN_LABEL_NOISE=0.05

ASPNETCORE_ENVIRONMENT=Development
